{
  "name": "weshirt",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "description": "WeShirt - 宿舍洗衣房状态看板与取衣提醒（H5 + EdgeOne/Node 双形态）",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "build:cloudbase": "node tools/cloudbase-fn/build-ingest.mjs",
    "build:channel-gateway": "node tools/cloudbase-fn/build-channel-gateway.mjs",
    "build:mobile-store": "node tools/cloudbase-fn/build-mobile-store.mjs",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:admin": "node --test tests/admin.test.js tests/admin-security.test.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "dompurify": "^3.4.18",
    "hono": "^4.13.19",
    "jsqr": "^1.4.0",
    "marked": "^18.2.1",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "three": "^0.187.0",
    "vant": "^4.9.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "vite": "^8.3.8",
    "ws": "^8.23.0"
  }
}
