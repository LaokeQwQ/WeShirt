# ---- 服务 ----
PORT=8787
DATA_DIR=./data
BUILDING_ID=b1
BUILDING_NAME=1 号楼

# ---- 安全（生产必须修改）----
AUTH_SECRET=
ADMIN_TOKEN=

# ---- 海乐生活数据源 ----
# mock: 使用内置模拟数据（默认，可直接体验）
# real: 使用真实接口。有 POSITION_ID 时走「楼层 × 类别」逐页拉取（推荐）
HAIER_MODE=mock
HAIER_URL=
HAIER_HEADERS={}
# 账号池（可选）：多个账号轮流打，某个被限流自动切下一个（冷却 10 分钟）
# 写法一（只给 Authorization）：["Bearer a","Bearer b"]
# 写法二（完整请求头）：[{"Authorization":"Bearer a","Cookie":"sid=1"},{"Authorization":"Bearer b"}]
# 配了就优先用账号池，忽略 HAIER_HEADERS；只有一个账号时等于现在的行为
HAIER_ACCOUNTS=
HAIER_PAYLOAD={}
# 洗衣房点位 id（GET /position/nearPosition 返回的 id）
HAIER_POSITION_ID=
# 每页条数
HAIER_PAGE_SIZE=100
# 整数 state 映射；海乐真实接口实测为 1=空闲 2=运行中 3=故障
HAIER_STATE_MAP={"idle":[1],"occupied":[2],"faulty":[3]}
# 上游单请求超时（毫秒）。调小可让首屏更快失败并保留旧看板
HAIER_TIMEOUT_MS=8000
# 看板数据超过这个毫秒数，被请求时就顺手刷新一次（默认 30000，即 30s）
SYNC_STALE_MS=30000
# 首次无缓存时最多等同步多久（毫秒），超时先返回 503 让前端提示重试
SYNC_WAIT_MS=2500

# ---- Web Push（用 node tools/gen-vapid.mjs 生成）----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=
VAPID_SUBJECT=mailto:dev@weshirt.local

# ---- 钉钉（开放平台 → 企业内部应用）----
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=
DINGTALK_AGENT_ID=
DINGTALK_AES_KEY=
DINGTALK_TOKEN=
# 群里自定义机器人 webhook（仅广播用，不计 Open API 配额）
DINGTALK_WEBHOOK=
DINGTALK_WEBHOOK_SECRET=

# ---- 可选 AI 助手（也可后台配置，默认关闭）----
ASSISTANT_ENABLED=false
ASSISTANT_ENDPOINT=https://api.openai.com/v1
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
